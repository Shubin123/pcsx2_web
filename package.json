{
  "name": "pcsx2_web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser frontend and validation harness for the PCSX2 WebAssembly port",
  "scripts": {
    "start": "node scripts/server.mjs",
    "sync": "node scripts/sync-runtime.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run test:archive && npm run test:library && npm run test:saves && node tests/browser.mjs",
    "test:library": "node tests/library-browser.mjs",
    "test:archive": "node --test tests/archive-download.mjs && node tests/archive-browser.mjs",
    "test:saves": "node --test tests/saves-unit.mjs && node tests/saves-browser.mjs",
    "test:game-import": "node tests/game-import.mjs",
    "test:game-framebuffer": "node tests/game-framebuffer.mjs",
    "test:performance": "node tests/performance.mjs",
    "test:game-controls": "node tests/game-controls.mjs",
    "test:controls": "node tests/controls.mjs",
    "test:input": "node tests/controls.mjs unit && node tests/controls.mjs contract",
    "test:speed": "node tests/speed-browser.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1"
  }
}
